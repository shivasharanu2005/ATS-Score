# GEMINI_API_KEY: Required for Gemini AI API calls (gemini-3.8-flash)
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Server Port
PORT=3000

# Authentication & Session Secret
AUTH_SECRET="your-super-secret-jwt-key"

# Database Configuration (for PostgreSQL / persistent storage)
DATABASE_URL="postgresql://user:password@localhost:5432/ai_ats"

